{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022", "DOM"],
    "outDir": "out", "rootDir": ".", "strict": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "sourceMap": true, "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", ".vscode-test"]
}
